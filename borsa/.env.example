# Hepsi isteğe bağlıdır; uygulama anahtarsız çalışır.
POSTGRES_PASSWORD=borsa
APP_PORT=3000

# Fiyat sağlayıcı: isyatirim (varsayılan, anahtarsız) | eodhd (lisanslı, anahtar gerekir)
PRICE_PROVIDER=isyatirim
EODHD_API_KEY=

# TCMB EVDS (Brent petrol serisi). Ücretsiz anahtar: evds2.tcmb.gov.tr → Profil → API Anahtarı
EVDS_API_KEY=
EVDS_BASE_URL=

# TEFAS farklı bir adresten sunuluyorsa
TEFAS_BASE_URL=

# /api/cron/daily uç noktasını korumak için (Authorization: Bearer …)
CRON_SECRET=

# Test: virgülle ayrılmış sağlayıcılar için kesinti benzetimi (isyatirim,kap,tcmb,tefas)
SIMULATE_OUTAGE=
